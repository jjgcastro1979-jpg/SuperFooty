<?xml version='1.0' encoding='utf-8'?>
<widget id="com.superfooty.premium" version="1.0.0" xmlns="http://w3.org" xmlns:android="http://android.com" xmlns:cdv="http://apache.org">
    <name>SuperFooty</name>
    <description>Análisis avanzado de fútbol en tiempo real con IA.</description>
    <author email="soporte@tuweb.com" href="http://github.com">SuperFooty Team</author>
    <content src="index.html" />
    
    <!-- Permisos de acceso total a Internet sin restricciones -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <platform name="android">
        <!-- Forzar al sistema de Android a permitir tráfico de datos de texto plano y seguro -->
        <edit-config edit="/*" target="AndroidManifest.xml" xmlns:android="http://android.com">
            <manifest android:usesCleartextTraffic="true" />
        </edit-config>
        <config-file parent="/*" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
        </config-file>
    </platform>
    
    <preference name="Orientation" value="portrait" />
</widget>
