<?xml version='1.0' encoding='utf-8'?>
<widget id="com.superfooty.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>SuperFooty</name>
    <description>Análisis de fútbol real.</description>
    <author email="soporte@superfooty.com">SuperFooty</author>
    <content src="index.html" />
    
    <!-- Permisos de red globales libres de bloqueos -->
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <preference name="Scheme" value="http" />
    <preference name="Hostname" value="localhost" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <preference name="Orientation" value="portrait" />

    <!-- Configuración obligatoria para compatibilidad con Android 12+ (Cordova 12) -->
    <platform name="android">
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
    </platform>
</widget>
